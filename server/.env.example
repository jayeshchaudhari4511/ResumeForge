# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/resumeforge
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/resumeforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/resumeforge

# JWT Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API Key for AI Job Match Analyzer
GEMINI_API_KEY=
